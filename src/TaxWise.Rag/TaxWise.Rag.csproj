<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TaxWise.Core\TaxWise.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="Qdrant.Client" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded byte-for-byte so the system prompt prefix stays cacheable (BUILD_PLAN §10). -->
    <EmbeddedResource Include="Prompts\*.md;Prompts\*.json" LogicalName="TaxWise.Rag.Prompts.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
