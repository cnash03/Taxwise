<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TaxWise.Rag\TaxWise.Rag.csproj" />
  </ItemGroup>

  <!-- The deployed API has no repo around it, so it ships the manifest and sample forms (not the PDFs; those redirect to irs.gov). -->
  <ItemGroup>
    <Content Include="..\..\data\sources\manifest.json" Link="data\sources\manifest.json" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <Content Include="..\..\data\forms\*-sample.json" Link="data\forms\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Shared with the other TaxWise hosts so one `dotnet user-secrets set` covers them all. -->
    <UserSecretsId>taxwise-dev</UserSecretsId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
